---
interface Props {
  youtubeId?: string;
  title: string;
  locale: 'es' | 'en';
}

const { youtubeId, title, locale } = Astro.props;
---

<div class="video-shell blueprint-card" data-youtube-facade={youtubeId || undefined}>
  {youtubeId ? (
    <button type="button" class="video-trigger" aria-label={`${locale === 'es' ? 'Reproducir vídeo' : 'Play video'}: ${title}`}>
      <span class="coordinates" aria-hidden="true">40.4168° N — 3.7038° W</span>
      <span class="play" aria-hidden="true">▶</span>
      <span class="video-label">YouTube · {locale === 'es' ? 'Cargar demo' : 'Load demo'}</span>
    </button>
  ) : (
    <div class="video-placeholder">
      <span class="coordinates" aria-hidden="true">VIDEO_FEED / NOT_CONNECTED</span>
      <span class="placeholder-mark" aria-hidden="true">▶</span>
      <div>
        <strong>{locale === 'es' ? 'Demo pendiente' : 'Demo coming soon'}</strong>
        <p>{locale === 'es' ? 'Añade un ID de YouTube al proyecto para activar el reproductor.' : 'Add a YouTube ID to the project to enable the player.'}</p>
      </div>
    </div>
  )}
</div>

{youtubeId && (
  <script>
    document.querySelectorAll<HTMLElement>('[data-youtube-facade]').forEach((facade) => {
      const button = facade.querySelector<HTMLButtonElement>('button');
      button?.addEventListener('click', () => {
        const id = facade.dataset.youtubeFacade;
        if (!id) return;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
        iframe.title = button.getAttribute('aria-label') ?? 'YouTube video';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        facade.replaceChildren(iframe);
      }, { once: true });
    });
  </script>
)}

<style>
  .video-shell { aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-forest); color: var(--color-paper); }
  .video-shell :global(iframe) { width: 100%; height: 100%; border: 0; }
  .video-trigger,
  .video-placeholder { position: relative; display: grid; width: 100%; height: 100%; place-items: center; border: 0; background: radial-gradient(circle at 50% 40%, #2b5a48, var(--color-forest) 65%); color: inherit; }
  .video-trigger { cursor: pointer; }
  .video-trigger::before,
  .video-placeholder::before { position: absolute; inset: 0; background-image: linear-gradient(rgba(244, 240, 231, 0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(244, 240, 231, 0.06) 1px, transparent 1px); background-size: 38px 38px; content: ""; }
  .coordinates { position: absolute; top: 1.2rem; left: 1.2rem; color: rgba(244, 240, 231, 0.66); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.1em; }
  .play,
  .placeholder-mark { position: relative; display: grid; width: 5rem; height: 5rem; place-items: center; border: 1px solid rgba(244, 240, 231, 0.72); border-radius: 50%; font-size: 1.1rem; transition: background-color 180ms ease, transform 180ms ease; }
  .video-trigger:hover .play { background: var(--color-paper); color: var(--color-forest); transform: scale(1.06); }
  .video-label { position: absolute; right: 1.2rem; bottom: 1.2rem; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .video-placeholder { align-content: center; gap: 1.4rem; padding: 2rem; text-align: center; }
  .video-placeholder strong { position: relative; font-family: var(--font-serif); font-size: 1.4rem; font-weight: 500; }
  .video-placeholder p { position: relative; max-width: 32rem; margin: 0.5rem auto 0; color: rgba(244, 240, 231, 0.65); font-size: 0.75rem; line-height: 1.6; }
</style>
