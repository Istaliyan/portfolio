<div class="hero-shader" aria-hidden="true">
  <canvas data-hero-shader></canvas>
</div>

<script>
  const generationVertexSource = `#version 300 es
    precision highp float;

    uniform ivec2 uChunkOrigin;
    uniform vec2 uCellSize;
    uniform int uChunkResolution;
    uniform vec2 uTravelOffset;
    uniform float uAspect;
    out vec4 tfVertex;
    out vec3 vWorldPosition;
    out float vHeight;
    out float vSurfaceField;
    out vec2 vTerrainCoordinate;

    vec2 gradientHash(vec2 p) {
      p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
      return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
    }

    float gradientNoise(vec2 p) {
      vec2 cell = floor(p);
      vec2 local = fract(p);
      vec2 blend = local * local * local * (local * (local * 6.0 - 15.0) + 10.0);
      float a = dot(gradientHash(cell), local);
      float b = dot(gradientHash(cell + vec2(1.0, 0.0)), local - vec2(1.0, 0.0));
      float c = dot(gradientHash(cell + vec2(0.0, 1.0)), local - vec2(0.0, 1.0));
      float d = dot(gradientHash(cell + vec2(1.0, 1.0)), local - vec2(1.0, 1.0));
      return mix(mix(a, b, blend.x), mix(c, d, blend.x), blend.y);
    }

    float fbm(vec2 p) {
      float value = 0.0;
      float amplitude = 0.52;
      mat2 rotation = mat2(0.80, -0.60, 0.60, 0.80);
      for (int i = 0; i < 5; i++) {
        value += amplitude * gradientNoise(p);
        p = rotation * p * 2.02 + vec2(7.3, 5.1);
        amplitude *= 0.48;
      }
      return value;
    }

    float ridgedFbm(vec2 p) {
      float value = 0.0;
      float amplitude = 0.52;
      float weight = 1.0;
      mat2 rotation = mat2(0.84, -0.54, 0.54, 0.84);
      for (int i = 0; i < 5; i++) {
        float ridge = 1.0 - abs(gradientNoise(p) * 1.75);
        ridge = max(ridge, 0.0);
        ridge *= ridge;
        ridge *= weight;
        value += ridge * amplitude;
        weight = clamp(ridge * 1.55, 0.12, 1.0);
        p = rotation * p * 2.04 + vec2(5.8, 9.2);
        amplitude *= 0.48;
      }
      return value;
    }

    float terrainHeight(vec2 p) {
      vec2 warp = vec2(
        gradientNoise(p * 0.24 + vec2(2.7, 8.4)),
        gradientNoise(p * 0.24 + vec2(9.1, 3.6))
      );
      float continental = fbm(p * 0.32 + warp * 0.42);
      float mountainMask = smoothstep(-0.22, 0.26, continental);
      float mountains = ridgedFbm(p * 0.68 + warp * 0.86 + vec2(4.7, 8.1));
      float detail = gradientNoise(p * 3.15 + warp * 1.25 + vec2(1.8, 6.4));
      float fineDetail = gradientNoise(p * 4.8 + warp * 1.7 + vec2(8.2, 2.9));
      return -0.10
           + continental * 0.76
           + mountainMask * (mountains - 0.28) * 0.74
           + detail * 0.055
           + fineDetail * 0.025;
    }

    void main() {
      int column = gl_VertexID % uChunkResolution;
      int row = gl_VertexID / uChunkResolution;
      vec2 terrainCoordinate = vec2(uChunkOrigin + ivec2(column, row)) * uCellSize;
      float height = terrainHeight(terrainCoordinate);
      float surfaceField = fbm(terrainCoordinate * 1.35 + vec2(3.1, 7.7));
      tfVertex = vec4(terrainCoordinate, height, surfaceField);

      vec2 worldCoordinate = terrainCoordinate - uTravelOffset;
      vec3 worldPosition = vec3(worldCoordinate.x, height, worldCoordinate.y);
      vec3 cameraOrigin = vec3(3.3, 2.72, 4.6);
      vec3 forward = normalize(vec3(0.5, -0.06, -0.35) - cameraOrigin);
      vec3 right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
      vec3 up = cross(right, forward);
      vec3 cameraOffset = worldPosition - cameraOrigin;
      vec3 viewPosition = vec3(
        dot(cameraOffset, right),
        dot(cameraOffset, up),
        dot(cameraOffset, forward)
      );
      const float nearPlane = 0.05;
      const float farPlane = 12.0;
      float clipZ = ((farPlane + nearPlane) / (farPlane - nearPlane)) * viewPosition.z
                  - (2.0 * farPlane * nearPlane) / (farPlane - nearPlane);
      gl_Position = vec4(
        viewPosition.x / (0.66 * uAspect),
        viewPosition.y / 0.66,
        clipZ,
        viewPosition.z
      );
      vWorldPosition = worldPosition;
      vHeight = height;
      vSurfaceField = surfaceField;
      vTerrainCoordinate = terrainCoordinate;
    }
  `;

  const renderVertexSource = `#version 300 es
    precision highp float;

    layout(location = 0) in vec2 aTerrainCoordinate;
    layout(location = 1) in float aHeight;
    layout(location = 2) in float aSurfaceField;
    uniform vec2 uTravelOffset;
    uniform float uAspect;
    out vec3 vWorldPosition;
    out float vHeight;
    out float vSurfaceField;
    out vec2 vTerrainCoordinate;

    void main() {
      vec2 worldCoordinate = aTerrainCoordinate - uTravelOffset;
      vec3 worldPosition = vec3(worldCoordinate.x, aHeight, worldCoordinate.y);
      vec3 cameraOrigin = vec3(3.3, 2.72, 4.6);
      vec3 forward = normalize(vec3(0.5, -0.06, -0.35) - cameraOrigin);
      vec3 right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
      vec3 up = cross(right, forward);
      vec3 cameraOffset = worldPosition - cameraOrigin;
      vec3 viewPosition = vec3(
        dot(cameraOffset, right),
        dot(cameraOffset, up),
        dot(cameraOffset, forward)
      );
      const float nearPlane = 0.05;
      const float farPlane = 12.0;
      float clipZ = ((farPlane + nearPlane) / (farPlane - nearPlane)) * viewPosition.z
                  - (2.0 * farPlane * nearPlane) / (farPlane - nearPlane);
      gl_Position = vec4(
        viewPosition.x / (0.66 * uAspect),
        viewPosition.y / 0.66,
        clipZ,
        viewPosition.z
      );
      vWorldPosition = worldPosition;
      vHeight = aHeight;
      vSurfaceField = aSurfaceField;
      vTerrainCoordinate = aTerrainCoordinate;
    }
  `;

  const fragmentSource = `#version 300 es
    precision highp float;

    uniform vec2 uResolution;
    in vec3 vWorldPosition;
    in float vHeight;
    in float vSurfaceField;
    in vec2 vTerrainCoordinate;
    out vec4 outColor;

    float valueHash(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z) * 2.0 - 1.0;
    }

    float valueNoise(vec2 p) {
      vec2 cell = floor(p);
      vec2 local = fract(p);
      vec2 blend = local * local * (3.0 - 2.0 * local);
      float a = valueHash(cell);
      float b = valueHash(cell + vec2(1.0, 0.0));
      float c = valueHash(cell + vec2(0.0, 1.0));
      float d = valueHash(cell + vec2(1.0, 1.0));
      return mix(mix(a, b, blend.x), mix(c, d, blend.x), blend.y);
    }

    void main() {
      const vec3 PAPER  = vec3(0.957, 0.941, 0.902);
      const vec3 WARM   = vec3(0.886, 0.843, 0.759);
      const vec3 MOSS   = vec3(0.345, 0.425, 0.329);
      const vec3 FOREST = vec3(0.082, 0.239, 0.188);
      const vec3 CLAY   = vec3(0.741, 0.420, 0.263);

      vec3 normal = normalize(cross(dFdx(vWorldPosition), dFdy(vWorldPosition)));
      if (normal.y < 0.0) normal = -normal;
      float heightTone = smoothstep(-0.38, 0.58, vHeight);
      float slope = 1.0 - normal.y;
      float diffuse = 0.5 + 0.5
                    * max(dot(normal, normalize(vec3(-0.5, 0.9, 0.35))), 0.0);
      float fineTexture = valueNoise(vTerrainCoordinate * 8.0 + vec2(1.6, 9.4));

      vec3 surface = mix(WARM, PAPER, 0.38 + diffuse * 0.44);
      float mossField = smoothstep(-0.34, 0.42, vSurfaceField + heightTone * 0.18);
      surface = mix(surface, MOSS, mossField * 0.24);
      surface = mix(surface, FOREST, smoothstep(0.16, 0.68, slope) * 0.34);
      float exposedTerrain = smoothstep(0.28, 0.70, slope)
                           * smoothstep(-0.18, 0.42, fineTexture);
      surface = mix(surface, CLAY, exposedTerrain * 0.24);
      surface *= 0.96 + vSurfaceField * 0.10 + fineTexture * 0.055;

      float distanceToTerrain = length(vWorldPosition - vec3(3.3, 2.72, 4.6));
      float haze = smoothstep(4.1, 8.8, distanceToTerrain);
      vec3 color = mix(surface, PAPER, haze);
      vec2 uv = (2.0 * gl_FragCoord.xy - uResolution) / uResolution.y;
      float vignette = 1.0
                     - smoothstep(0.45, 1.65, length(uv * vec2(0.78, 0.92)));
      color = mix(color * 0.975, color * 1.018, vignette);
      color = pow(max(color, 0.0), vec3(0.97));
      outColor = vec4(color, 1.0);
    }
  `;

const qualityTiers = [
    { columns: 5000, rows: 2500, desktopScale: 0.8, mobileScale: 0.6 },
    { columns: 2500, rows: 1250, desktopScale: 0.7, mobileScale: 0.5 },
    { columns: 1250, rows: 625, desktopScale: 0.6, mobileScale: 0.4 },
  ] as const;
  const chunkResolution = 49;
  const chunkVertexCount = chunkResolution * chunkResolution;
  const chunkIndexCount = (chunkResolution - 1) * (chunkResolution - 1) * 6;
  const terrainMinX = -9;
  const terrainMaxX = 11;
  const terrainMinZ = -6.5;
  const terrainMaxZ = 6;
  const terrainCullDistance = 10;

  type TerrainChunk = {
    buffer: WebGLBuffer;
    vertexArray: WebGLVertexArrayObject;
    x: number;
    z: number;
  };

  function compileShader(
    gl: WebGL2RenderingContext,
    type: number,
    source: string,
  ): WebGLShader | null {
    const shader = gl.createShader(type);
    if (!shader) return null;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      console.warn('Hero shader compilation failed:', gl.getShaderInfoLog(shader));
      gl.deleteShader(shader);
      return null;
    }
    return shader;
  }

  function linkProgram(
    gl: WebGL2RenderingContext,
    shaders: WebGLShader[],
    transformFeedbackVaryings?: string[],
  ): WebGLProgram | null {
    const program = gl.createProgram();
    if (!program) return null;
    for (const shader of shaders) gl.attachShader(program, shader);
    if (transformFeedbackVaryings) {
      gl.transformFeedbackVaryings(
        program,
        transformFeedbackVaryings,
        gl.INTERLEAVED_ATTRIBS,
      );
    }
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.warn('Hero shader linking failed:', gl.getProgramInfoLog(program));
      gl.deleteProgram(program);
      return null;
    }
    return program;
  }

  function initializeHeroShader(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext('webgl2', {
      alpha: false,
      antialias: false,
      depth: true,
      stencil: false,
      powerPreference: 'high-performance',
      preserveDrawingBuffer: false,
    });
    if (!gl) {
      canvas.hidden = true;
      return;
    }

    const generationVertexShader = compileShader(
      gl,
      gl.VERTEX_SHADER,
      generationVertexSource,
    );
    const renderVertexShader = compileShader(gl, gl.VERTEX_SHADER, renderVertexSource);
    const renderFragmentShader = compileShader(gl, gl.FRAGMENT_SHADER, fragmentSource);
    const shaders = [
      generationVertexShader,
      renderVertexShader,
      renderFragmentShader,
    ];
    if (shaders.some((shader) => !shader)) {
      for (const shader of shaders) {
        if (shader) gl.deleteShader(shader);
      }
      canvas.hidden = true;
      return;
    }

    let generationProgram = linkProgram(
      gl,
      [generationVertexShader!, renderFragmentShader!],
      ['tfVertex'],
    );
    const cacheProgramLinked = generationProgram !== null;
    if (!generationProgram) {
      generationProgram = linkProgram(
        gl,
        [generationVertexShader!, renderFragmentShader!],
      );
    }
    const renderProgram = linkProgram(
      gl,
      [renderVertexShader!, renderFragmentShader!],
    );
    if (!generationProgram || !renderProgram) {
      if (generationProgram) gl.deleteProgram(generationProgram);
      if (renderProgram) gl.deleteProgram(renderProgram);
      for (const shader of shaders) gl.deleteShader(shader!);
      canvas.hidden = true;
      return;
    }

    const generationVertexArray = gl.createVertexArray();
    const transformFeedback = gl.createTransformFeedback();
    const indexBuffer = gl.createBuffer();
    if (!generationVertexArray || !transformFeedback || !indexBuffer) {
      if (generationVertexArray) gl.deleteVertexArray(generationVertexArray);
      if (transformFeedback) gl.deleteTransformFeedback(transformFeedback);
      if (indexBuffer) gl.deleteBuffer(indexBuffer);
      gl.deleteProgram(generationProgram);
      gl.deleteProgram(renderProgram);
      for (const shader of shaders) gl.deleteShader(shader!);
      canvas.hidden = true;
      return;
    }

    const indices = new Uint16Array(chunkIndexCount);
    let indexOffset = 0;
    for (let row = 0; row < chunkResolution - 1; row += 1) {
      for (let column = 0; column < chunkResolution - 1; column += 1) {
        const topLeft = row * chunkResolution + column;
        const topRight = topLeft + 1;
        const bottomLeft = topLeft + chunkResolution;
        const bottomRight = bottomLeft + 1;
        indices[indexOffset] = topLeft;
        indices[indexOffset + 1] = bottomLeft;
        indices[indexOffset + 2] = topRight;
        indices[indexOffset + 3] = topRight;
        indices[indexOffset + 4] = bottomLeft;
        indices[indexOffset + 5] = bottomRight;
        indexOffset += 6;
      }
    }
    gl.bindVertexArray(generationVertexArray);
    gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, indexBuffer);
    gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, indices, gl.STATIC_DRAW);
    gl.bindVertexArray(null);

    const generationOriginLocation = gl.getUniformLocation(
      generationProgram,
      'uChunkOrigin',
    );
    const generationCellSizeLocation = gl.getUniformLocation(
      generationProgram,
      'uCellSize',
    );
    const generationResolutionLocation = gl.getUniformLocation(
      generationProgram,
      'uChunkResolution',
    );
    const generationTravelOffsetLocation = gl.getUniformLocation(
      generationProgram,
      'uTravelOffset',
    );
    const generationAspectLocation = gl.getUniformLocation(
      generationProgram,
      'uAspect',
    );
    const generationRenderResolutionLocation = gl.getUniformLocation(
      generationProgram,
      'uResolution',
    );
    const resolutionLocation = gl.getUniformLocation(renderProgram, 'uResolution');
    const travelOffsetLocation = gl.getUniformLocation(renderProgram, 'uTravelOffset');
    const aspectLocation = gl.getUniformLocation(renderProgram, 'uAspect');
    const timerExtension = gl.getExtension('EXT_disjoint_timer_query_webgl2');
    const pendingQueries: WebGLQuery[] = [];
    const gpuSamples: number[] = [];
    const activeChunks = new Map<string, TerrainChunk>();
    const chunkPool: TerrainChunk[] = [];
    let cellWidth = 1;
    let cellDepth = 1;
    let chunkWidth = 1;
    let chunkDepth = 1;
    let qualityIndex = 0;
    let isIntersecting = true;
    let frameRequest = 0;
    let lastTick = 0;
    let lastDraw = 0;
    let activeTime = 0;
    let targetFrameRate = 60;
    let deadlineWindowStart = 0;
    let missedDeadlines = 0;
    let cacheAvailable = cacheProgramLinked;
    let cacheValidated = false;
    let disposed = false;
    const debugEnabled = new URLSearchParams(window.location.search)
      .get('shaderDebug') === '1';
    const debugPanel = debugEnabled ? document.createElement('output') : null;
    let debugDrawCount = 0;
    let debugWindowStarted = performance.now();

    if (debugPanel) {
      debugPanel.setAttribute('aria-hidden', 'true');
      Object.assign(debugPanel.style, {
        position: 'fixed',
        top: '0.75rem',
        right: '0.75rem',
        zIndex: '2147483647',
        margin: '0',
        padding: '0.65rem 0.75rem',
        border: '1px solid rgba(244, 240, 231, 0.28)',
        borderRadius: '4px',
        background: 'rgba(8, 28, 22, 0.9)',
        boxShadow: '0 4px 18px rgba(0, 0, 0, 0.18)',
        color: '#f4f0e7',
        font: '600 11px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace',
        pointerEvents: 'none',
        whiteSpace: 'pre',
      });
      document.body.append(debugPanel);
    }

    const updateGridMetrics = () => {
      const tier = qualityTiers[qualityIndex];
      cellWidth = 20 / (tier.columns - 1);
      cellDepth = 16 / (tier.rows - 1);
      chunkWidth = cellWidth * (chunkResolution - 1);
      chunkDepth = cellDepth * (chunkResolution - 1);
    };
    updateGridMetrics();

    const createChunk = (): TerrainChunk | null => {
      const buffer = gl.createBuffer();
      const vertexArray = gl.createVertexArray();
      if (!buffer || !vertexArray) {
        if (buffer) gl.deleteBuffer(buffer);
        if (vertexArray) gl.deleteVertexArray(vertexArray);
        return null;
      }

      gl.bindBuffer(gl.TRANSFORM_FEEDBACK_BUFFER, buffer);
      gl.bufferData(
        gl.TRANSFORM_FEEDBACK_BUFFER,
        chunkVertexCount * 4 * Float32Array.BYTES_PER_ELEMENT,
        gl.DYNAMIC_COPY,
      );
      gl.bindBuffer(gl.TRANSFORM_FEEDBACK_BUFFER, null);

      gl.bindVertexArray(vertexArray);
      gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
      gl.enableVertexAttribArray(0);
      gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 16, 0);
      gl.enableVertexAttribArray(1);
      gl.vertexAttribPointer(1, 1, gl.FLOAT, false, 16, 8);
      gl.enableVertexAttribArray(2);
      gl.vertexAttribPointer(2, 1, gl.FLOAT, false, 16, 12);
      gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, indexBuffer);
      gl.bindVertexArray(null);
      gl.bindBuffer(gl.ARRAY_BUFFER, null);

      return { buffer, vertexArray, x: 0, z: 0 };
    };

    const generateChunk = (
      chunk: TerrainChunk,
      chunkX: number,
      chunkZ: number,
    ) => {
      chunk.x = chunkX;
      chunk.z = chunkZ;
      if (!cacheAvailable) return;
      for (let errorIndex = 0; errorIndex < 8; errorIndex += 1) {
        if (gl.getError() === gl.NO_ERROR) break;
      }
      gl.useProgram(generationProgram);
      gl.uniform2i(
        generationOriginLocation,
        chunkX * (chunkResolution - 1),
        chunkZ * (chunkResolution - 1),
      );
      gl.uniform2f(generationCellSizeLocation, cellWidth, cellDepth);
      gl.uniform1i(generationResolutionLocation, chunkResolution);
      gl.bindVertexArray(generationVertexArray);
      gl.bindBuffer(gl.ARRAY_BUFFER, null);
      gl.bindTransformFeedback(gl.TRANSFORM_FEEDBACK, transformFeedback);
      gl.bindBufferBase(gl.TRANSFORM_FEEDBACK_BUFFER, 0, chunk.buffer);
      gl.enable(gl.RASTERIZER_DISCARD);
      gl.beginTransformFeedback(gl.POINTS);
      gl.drawArrays(gl.POINTS, 0, chunkVertexCount);
      gl.endTransformFeedback();
      gl.disable(gl.RASTERIZER_DISCARD);
      gl.bindBufferBase(gl.TRANSFORM_FEEDBACK_BUFFER, 0, null);
      gl.bindTransformFeedback(gl.TRANSFORM_FEEDBACK, null);
      gl.bindBuffer(gl.TRANSFORM_FEEDBACK_BUFFER, null);

      if (gl.getError() !== gl.NO_ERROR) {
        cacheAvailable = false;
        console.warn('Hero terrain cache unavailable; using procedural fallback.');
        return;
      }

      if (!cacheValidated) {
        const sample = new Float32Array(4);
        gl.bindBuffer(gl.COPY_READ_BUFFER, chunk.buffer);
        gl.getBufferSubData(gl.COPY_READ_BUFFER, 0, sample);
        gl.bindBuffer(gl.COPY_READ_BUFFER, null);
        const expectedX = chunkX * (chunkResolution - 1) * cellWidth;
        const expectedZ = chunkZ * (chunkResolution - 1) * cellDepth;
        const validSample = Array.from(sample).every(Number.isFinite)
          && Math.abs(sample[0] - expectedX) < 0.001
          && Math.abs(sample[1] - expectedZ) < 0.001;
        if (!validSample || gl.getError() !== gl.NO_ERROR) {
          cacheAvailable = false;
          console.warn('Hero terrain cache produced invalid data; using procedural fallback.');
          return;
        }
        cacheValidated = true;
      }
    };

    const travelLength = Math.hypot(3.3, 4.95);
    const travelXPerSecond = (-3.3 / travelLength) * 0.32;
    const travelZPerSecond = (-4.95 / travelLength) * 0.32;
    const cameraX = 3.3;
    const cameraZ = 4.6;
    const cameraForwardLength = Math.hypot(0.5 - cameraX, -0.35 - cameraZ);
    const cameraForwardX = (0.5 - cameraX) / cameraForwardLength;
    const cameraForwardZ = (-0.35 - cameraZ) / cameraForwardLength;
    const syncChunks = (travelX: number, travelZ: number) => {
      const minChunkX = Math.floor((terrainMinX + travelX) / chunkWidth);
      const maxChunkX = Math.floor((terrainMaxX + travelX) / chunkWidth);
      const minChunkZ = Math.floor((terrainMinZ + travelZ) / chunkDepth);
      const maxChunkZ = Math.floor((terrainMaxZ + travelZ) / chunkDepth);
      const desiredChunks = new Map<string, [number, number]>();

      for (let chunkZ = minChunkZ; chunkZ <= maxChunkZ; chunkZ += 1) {
        for (let chunkX = minChunkX; chunkX <= maxChunkX; chunkX += 1) {
          const worldMinX = chunkX * chunkWidth - travelX;
          const worldMaxX = worldMinX + chunkWidth;
          const worldMinZ = chunkZ * chunkDepth - travelZ;
          const worldMaxZ = worldMinZ + chunkDepth;
          const distanceX = cameraX < worldMinX
            ? worldMinX - cameraX
            : cameraX > worldMaxX ? cameraX - worldMaxX : 0;
          const distanceZ = cameraZ < worldMinZ
            ? worldMinZ - cameraZ
            : cameraZ > worldMaxZ ? cameraZ - worldMaxZ : 0;
          const furthestForwardX = cameraForwardX < 0 ? worldMinX : worldMaxX;
          const furthestForwardZ = cameraForwardZ < 0 ? worldMinZ : worldMaxZ;
          const furthestForward = (furthestForwardX - cameraX) * cameraForwardX
                                + (furthestForwardZ - cameraZ) * cameraForwardZ;
          if (Math.hypot(distanceX, distanceZ) > terrainCullDistance) continue;
          if (furthestForward < -2) continue;
          desiredChunks.set(`${chunkX}:${chunkZ}`, [chunkX, chunkZ]);
        }
      }

      for (const [key, chunk] of activeChunks) {
        if (desiredChunks.has(key)) continue;
        activeChunks.delete(key);
        chunkPool.push(chunk);
      }

      for (const [key, [chunkX, chunkZ]] of desiredChunks) {
        if (activeChunks.has(key)) continue;
        const chunk = chunkPool.pop() ?? createChunk();
        if (!chunk) continue;
        generateChunk(chunk, chunkX, chunkZ);
        activeChunks.set(key, chunk);
      }
    };

    gl.clearColor(0.957, 0.941, 0.902, 1);
    gl.enable(gl.DEPTH_TEST);
    gl.depthFunc(gl.LEQUAL);
    gl.enable(gl.CULL_FACE);
    gl.cullFace(gl.BACK);
    gl.frontFace(gl.CCW);
    canvas.dataset.shaderState = 'ready';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const clearQueries = () => {
      for (const query of pendingQueries) gl.deleteQuery(query);
      pendingQueries.length = 0;
    };

    const draw = (measureGpu = false) => {
      if (disposed) return;
      const travelX = travelXPerSecond * activeTime;
      const travelZ = travelZPerSecond * activeTime;
      const shouldMeasure = measureGpu && timerExtension && pendingQueries.length < 8;
      const query = shouldMeasure ? gl.createQuery() : null;
      if (query && timerExtension) gl.beginQuery(timerExtension.TIME_ELAPSED_EXT, query);

      syncChunks(travelX, travelZ);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
      if (cacheAvailable) {
        gl.useProgram(renderProgram);
        gl.uniform2f(resolutionLocation, canvas.width, canvas.height);
        gl.uniform2f(travelOffsetLocation, travelX, travelZ);
        gl.uniform1f(aspectLocation, canvas.width / canvas.height);
        for (const chunk of activeChunks.values()) {
          gl.bindVertexArray(chunk.vertexArray);
          gl.drawElements(gl.TRIANGLES, chunkIndexCount, gl.UNSIGNED_SHORT, 0);
        }
      } else {
        gl.useProgram(generationProgram);
        gl.uniform2f(
          generationRenderResolutionLocation,
          canvas.width,
          canvas.height,
        );
        gl.uniform2f(generationCellSizeLocation, cellWidth, cellDepth);
        gl.uniform1i(generationResolutionLocation, chunkResolution);
        gl.uniform2f(generationTravelOffsetLocation, travelX, travelZ);
        gl.uniform1f(generationAspectLocation, canvas.width / canvas.height);
        gl.bindVertexArray(generationVertexArray);
        for (const chunk of activeChunks.values()) {
          gl.uniform2i(
            generationOriginLocation,
            chunk.x * (chunkResolution - 1),
            chunk.z * (chunkResolution - 1),
          );
          gl.drawElements(gl.TRIANGLES, chunkIndexCount, gl.UNSIGNED_SHORT, 0);
        }
      }

      if (query && timerExtension) {
        gl.endQuery(timerExtension.TIME_ELAPSED_EXT);
        pendingQueries.push(query);
      }
      debugDrawCount += 1;
    };

    const updateDebugPanel = () => {
      if (!debugPanel) return;
      const now = performance.now();
      const elapsed = Math.max(1, now - debugWindowStarted);
      const fps = (debugDrawCount * 1000) / elapsed;
      const tier = qualityTiers[qualityIndex];
      const averageGpuTime = gpuSamples.length > 0
        ? gpuSamples.reduce((sum, sample) => sum + sample, 0) / gpuSamples.length
        : null;
      const triangleCount = activeChunks.size * (chunkIndexCount / 3);
      debugPanel.textContent = [
        `SHADER ${fps.toFixed(0).padStart(2)} FPS`,
        `TARGET ${targetFrameRate} FPS`,
        `GPU    ${averageGpuTime === null ? 'n/a' : `${averageGpuTime.toFixed(1)} ms`}`,
        `TIER   ${['HIGH', 'MEDIUM', 'LOW'][qualityIndex]} ${tier.columns}×${tier.rows}`,
        `CACHE  ${cacheAvailable ? 'ACTIVE' : 'FALLBACK'}`,
        `CHUNKS ${activeChunks.size}`,
        `TRIS   ${triangleCount.toLocaleString()}`,
        `BUFFER ${canvas.width}×${canvas.height}`,
      ].join('\n');
      debugDrawCount = 0;
      debugWindowStarted = now;
    };
    const debugInterval = debugPanel
      ? window.setInterval(updateDebugPanel, 1000)
      : 0;
    updateDebugPanel();

    const resize = () => {
      if (disposed) return;
      const bounds = canvas.getBoundingClientRect();
      const tier = qualityTiers[qualityIndex];
      const renderScale = window.innerWidth < 900 ? tier.mobileScale : tier.desktopScale;
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.25);
      const width = Math.max(1, Math.round(bounds.width * pixelRatio * renderScale));
      const height = Math.max(1, Math.round(bounds.height * pixelRatio * renderScale));
      if (canvas.width !== width || canvas.height !== height) {
        canvas.width = width;
        canvas.height = height;
        draw();
      }
    };

    const downgradeQuality = () => {
      const nextQualityIndex = qualityIndex + 1;
      const nextTier = qualityTiers[nextQualityIndex];
      if (!nextTier) return false;
      for (const chunk of activeChunks.values()) chunkPool.push(chunk);
      activeChunks.clear();
      qualityIndex = nextQualityIndex;
      updateGridMetrics();
      gpuSamples.length = 0;
      clearQueries();
      deadlineWindowStart = 0;
      missedDeadlines = 0;
      resize();
      return true;
    };

    const reduceRenderLoad = () => {
      if (downgradeQuality() || targetFrameRate === 30) return;
      targetFrameRate = 30;
      gpuSamples.length = 0;
      clearQueries();
      deadlineWindowStart = 0;
      missedDeadlines = 0;
      lastDraw = 0;
    };

    const pollGpuQueries = () => {
      if (!timerExtension || pendingQueries.length === 0) return;
      if (gl.getParameter(timerExtension.GPU_DISJOINT_EXT)) {
        clearQueries();
        gpuSamples.length = 0;
        return;
      }
      while (pendingQueries.length > 0) {
        const query = pendingQueries[0];
        if (!gl.getQueryParameter(query, gl.QUERY_RESULT_AVAILABLE)) break;
        pendingQueries.shift();
        const elapsedNanoseconds = gl.getQueryParameter(query, gl.QUERY_RESULT) as number;
        gl.deleteQuery(query);
        const elapsedMilliseconds = elapsedNanoseconds / 1_000_000;
        if (!Number.isFinite(elapsedMilliseconds)) continue;
        gpuSamples.push(elapsedMilliseconds);
        if (gpuSamples.length > 8) gpuSamples.shift();
        if (gpuSamples.length === 8) {
          const average = gpuSamples.reduce((sum, sample) => sum + sample, 0)
                        / gpuSamples.length;
          const gpuBudget = targetFrameRate === 60 ? 14 : 25;
          if (average > gpuBudget) {
            reduceRenderLoad();
            return;
          }
        }
      }
    };

    const recordMissedDeadline = (timestamp: number, elapsed: number) => {
      if (
        timerExtension
        || (qualityIndex === qualityTiers.length - 1 && targetFrameRate === 30)
      ) return;
      const frameDuration = 1000 / targetFrameRate;
      if (!deadlineWindowStart) deadlineWindowStart = timestamp;
      if (elapsed > frameDuration * 1.15) {
        missedDeadlines += Math.max(1, Math.floor(elapsed / frameDuration) - 1);
      }
      if (timestamp - deadlineWindowStart >= 1000) {
        const shouldDowngrade = missedDeadlines >= 4;
        deadlineWindowStart = timestamp;
        missedDeadlines = 0;
        if (shouldDowngrade) reduceRenderLoad();
      }
    };

    const canAnimate = () => (
      !disposed && isIntersecting && !document.hidden && !reducedMotion.matches
    );
    const stop = () => {
      if (frameRequest) cancelAnimationFrame(frameRequest);
      frameRequest = 0;
      lastTick = 0;
      lastDraw = 0;
      deadlineWindowStart = 0;
      missedDeadlines = 0;
    };
    const loop = (timestamp: number) => {
      frameRequest = 0;
      if (!canAnimate()) return;
      if (lastTick) activeTime += Math.min(timestamp - lastTick, 80) / 1000;
      lastTick = timestamp;
      pollGpuQueries();
      const frameDuration = 1000 / targetFrameRate;
      const elapsed = lastDraw ? timestamp - lastDraw : frameDuration;
      if (elapsed >= frameDuration - 0.5) {
        recordMissedDeadline(timestamp, elapsed);
        draw(true);
        lastDraw = lastDraw && elapsed >= frameDuration
          ? timestamp - (elapsed % frameDuration)
          : timestamp;
      }
      frameRequest = requestAnimationFrame(loop);
    };
    const updatePlayback = () => {
      if (canAnimate()) {
        if (!frameRequest) frameRequest = requestAnimationFrame(loop);
      } else {
        stop();
        if (reducedMotion.matches) {
          activeTime = 0;
          draw();
        }
      }
    };

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(canvas);
    const intersectionObserver = new IntersectionObserver(([entry]) => {
      isIntersecting = entry?.isIntersecting ?? false;
      updatePlayback();
    }, { threshold: 0.01 });
    intersectionObserver.observe(canvas);
    const handleVisibility = () => updatePlayback();
    const handleMotionPreference = () => updatePlayback();
    document.addEventListener('visibilitychange', handleVisibility);
    reducedMotion.addEventListener('change', handleMotionPreference);

    const dispose = () => {
      if (disposed) return;
      disposed = true;
      stop();
      resizeObserver.disconnect();
      intersectionObserver.disconnect();
      document.removeEventListener('visibilitychange', handleVisibility);
      reducedMotion.removeEventListener('change', handleMotionPreference);
      if (debugInterval) window.clearInterval(debugInterval);
      debugPanel?.remove();
      clearQueries();
      for (const chunk of activeChunks.values()) {
        gl.deleteBuffer(chunk.buffer);
        gl.deleteVertexArray(chunk.vertexArray);
      }
      for (const chunk of chunkPool) {
        gl.deleteBuffer(chunk.buffer);
        gl.deleteVertexArray(chunk.vertexArray);
      }
      activeChunks.clear();
      chunkPool.length = 0;
      gl.deleteBuffer(indexBuffer);
      gl.deleteTransformFeedback(transformFeedback);
      gl.deleteVertexArray(generationVertexArray);
      gl.deleteProgram(generationProgram);
      gl.deleteProgram(renderProgram);
      for (const shader of shaders) gl.deleteShader(shader!);
    };

    canvas.addEventListener('webglcontextlost', (event) => {
      event.preventDefault();
      canvas.hidden = true;
      dispose();
    }, { once: true });
    window.addEventListener('pagehide', dispose, { once: true });
    resize();
    updatePlayback();
  }

  document.querySelectorAll<HTMLCanvasElement>('[data-hero-shader]')
    .forEach(initializeHeroShader);
</script>

<style>
  .hero-shader {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, transparent, black 7%, black 91%, transparent);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  canvas[data-shader-state='ready'] {
    opacity: 0.9;
  }
</style>
