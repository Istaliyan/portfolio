<div class="hero-shader" aria-hidden="true">
  <canvas data-hero-shader></canvas>
  <div class="hero-shader__veil"></div>
</div>

<script>
  const shaderToySource = String.raw`
    vec2 gradientHash(vec2 p) {
      p = vec2(
        dot(p, vec2(127.1, 311.7)),
        dot(p, vec2(269.5, 183.3))
      );

      return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
    }

    float gradientNoise(vec2 p) {
      vec2 cell = floor(p);
      vec2 local = fract(p);
      vec2 blend = local * local * local
                 * (local * (local * 6.0 - 15.0) + 10.0);

      float a = dot(gradientHash(cell), local);
      float b = dot(gradientHash(cell + vec2(1.0, 0.0)), local - vec2(1.0, 0.0));
      float c = dot(gradientHash(cell + vec2(0.0, 1.0)), local - vec2(0.0, 1.0));
      float d = dot(gradientHash(cell + vec2(1.0, 1.0)), local - vec2(1.0, 1.0));

      return mix(mix(a, b, blend.x), mix(c, d, blend.x), blend.y);
    }

    float fbm(vec2 p) {
      float value = 0.0;
      float amplitude = 0.52;
      mat2 rotation = mat2(0.80, -0.60, 0.60, 0.80);

      for (int i = 0; i < 4; i++) {
        value += amplitude * gradientNoise(p);
        p = rotation * p * 2.02 + vec2(7.3, 5.1);
        amplitude *= 0.48;
      }

      return value;
    }

    float ridgedFbm(vec2 p) {
      float value = 0.0;
      float amplitude = 0.52;
      float weight = 1.0;
      mat2 rotation = mat2(0.84, -0.54, 0.54, 0.84);

      for (int i = 0; i < 4; i++) {
        float ridge = 1.0 - abs(gradientNoise(p) * 1.75);
        ridge = max(ridge, 0.0);
        ridge *= ridge;
        ridge *= weight;

        value += ridge * amplitude;
        weight = clamp(ridge * 1.55, 0.12, 1.0);
        p = rotation * p * 2.04 + vec2(5.8, 9.2);
        amplitude *= 0.48;
      }

      return value;
    }

    float terrainHeight(vec2 p) {
      vec2 warp = vec2(
        gradientNoise(p * 0.24 + vec2(2.7, 8.4)),
        gradientNoise(p * 0.24 + vec2(9.1, 3.6))
      );

      float continental = fbm(p * 0.32 + warp * 0.42);
      float mountainMask = smoothstep(-0.22, 0.26, continental);
      float mountains = ridgedFbm(p * 0.68 + warp * 0.86 + vec2(4.7, 8.1));
      float detail = gradientNoise(p * 3.15 + warp * 1.25 + vec2(1.8, 6.4));

      return -0.10
           + continental * 0.76
           + mountainMask * (mountains - 0.28) * 0.74
           + detail * 0.055;
    }

    float intersectTerrain(vec3 rayOrigin, vec3 rayDirection) {
      float previousT = 0.0;
      float t = 0.0;

      for (int i = 0; i < 64; i++) {
        vec3 position = rayOrigin + rayDirection * t;
        float distanceToSurface = position.y - terrainHeight(position.xz);

        if (distanceToSurface < 0.0) {
          float nearT = previousT;
          float farT = t;

          for (int j = 0; j < 5; j++) {
            float middleT = 0.5 * (nearT + farT);
            vec3 middlePosition = rayOrigin + rayDirection * middleT;
            float middleDistance = middlePosition.y - terrainHeight(middlePosition.xz);

            if (middleDistance > 0.0) {
              nearT = middleT;
            } else {
              farT = middleT;
            }
          }

          return 0.5 * (nearT + farT);
        }

        previousT = t;
        t += clamp(distanceToSurface * 0.38, 0.025, 0.18);

        if (t > 10.0) break;
      }

      return -1.0;
    }

    vec3 facetedNormal(vec2 p) {
      float meshDensity = 4.25;
      vec2 meshPosition = p * meshDensity;
      vec2 cell = floor(meshPosition);
      vec2 local = fract(meshPosition);

      vec2 a;
      vec2 b;
      vec2 c;

      if (local.x + local.y < 1.0) {
        a = cell / meshDensity;
        b = (cell + vec2(0.0, 1.0)) / meshDensity;
        c = (cell + vec2(1.0, 0.0)) / meshDensity;
      } else {
        a = (cell + vec2(1.0)) / meshDensity;
        b = (cell + vec2(1.0, 0.0)) / meshDensity;
        c = (cell + vec2(0.0, 1.0)) / meshDensity;
      }

      vec3 vertexA = vec3(a.x, terrainHeight(a), a.y);
      vec3 vertexB = vec3(b.x, terrainHeight(b), b.y);
      vec3 vertexC = vec3(c.x, terrainHeight(c), c.y);

      return normalize(cross(vertexB - vertexA, vertexC - vertexA));
    }

    vec3 smoothTerrainNormal(vec2 p) {
      float epsilon = 0.014;
      float left = terrainHeight(p - vec2(epsilon, 0.0));
      float right = terrainHeight(p + vec2(epsilon, 0.0));
      float back = terrainHeight(p - vec2(0.0, epsilon));
      float front = terrainHeight(p + vec2(0.0, epsilon));

      return normalize(vec3(left - right, 2.0 * epsilon, back - front));
    }

    void mainImage(out vec4 fragColor, in vec2 fragCoord) {
      vec2 uv = (2.0 * fragCoord - iResolution.xy) / iResolution.y;

      const vec3 PAPER  = vec3(0.957, 0.941, 0.902);
      const vec3 WARM   = vec3(0.886, 0.843, 0.759);
      const vec3 MOSS   = vec3(0.345, 0.425, 0.329);
      const vec3 FOREST = vec3(0.082, 0.239, 0.188);
      const vec3 CLAY   = vec3(0.741, 0.420, 0.263);

      vec2 travelDirection = normalize(vec2(-3.3, -4.95));
      vec3 travelOffset = vec3(travelDirection.x, 0.0, travelDirection.y)
                        * iTime * 0.32;
      vec3 rayOrigin = vec3(3.3, 2.72, 4.6) + travelOffset;
      vec3 target = vec3(0.0, 0.06, -0.35) + travelOffset;
      vec3 forward = normalize(target - rayOrigin);
      vec3 right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
      vec3 up = cross(right, forward);
      vec3 rayDirection = normalize(forward + uv.x * right * 0.66 + uv.y * up * 0.66);

      vec3 color = PAPER;
      float distanceToTerrain = intersectTerrain(rayOrigin, rayDirection);

      if (distanceToTerrain > 0.0) {
        vec3 position = rayOrigin + rayDirection * distanceToTerrain;
        vec3 facetNormal = facetedNormal(position.xz);
        vec3 smoothNormal = smoothTerrainNormal(position.xz);
        vec3 normal = normalize(mix(smoothNormal, facetNormal, 0.58));

        float heightTone = smoothstep(-0.38, 0.58, position.y);
        float slope = 1.0 - normal.y;
        float diffuse = 0.5 + 0.5 * max(dot(normal, normalize(vec3(-0.5, 0.9, 0.35))), 0.0);
        float surfaceField = fbm(position.xz * 1.35 + vec2(3.1, 7.7));
        float fineTexture = gradientNoise(position.xz * 8.0 + vec2(1.6, 9.4));

        vec3 surface = mix(WARM, PAPER, 0.38 + diffuse * 0.44);
        float mossField = smoothstep(-0.34, 0.42, surfaceField + heightTone * 0.18);
        surface = mix(surface, MOSS, mossField * 0.24);
        surface = mix(surface, FOREST, smoothstep(0.16, 0.68, slope) * 0.34);

        float exposedTerrain = smoothstep(0.28, 0.70, slope)
                             * smoothstep(-0.18, 0.42, fineTexture);
        surface = mix(surface, CLAY, exposedTerrain * 0.24);
        surface *= 0.96 + surfaceField * 0.10 + fineTexture * 0.055;

        float haze = smoothstep(4.1, 9.2, distanceToTerrain);
        color = mix(surface, PAPER, haze * 0.82);
      }

      float vignette = 1.0 - smoothstep(0.45, 1.65, length(uv * vec2(0.78, 0.92)));
      color = mix(color * 0.975, color * 1.018, vignette);
      color = pow(max(color, 0.0), vec3(0.97));

      fragColor = vec4(color, 1.0);
    }
  `;

  const vertexSource = `#version 300 es
    precision highp float;

    const vec2 positions[3] = vec2[3](
      vec2(-1.0, -1.0),
      vec2( 3.0, -1.0),
      vec2(-1.0,  3.0)
    );

    void main() {
      gl_Position = vec4(positions[gl_VertexID], 0.0, 1.0);
    }
  `;

  const fragmentSource = `#version 300 es
    precision highp float;

    uniform vec3 iResolution;
    uniform float iTime;
    out vec4 outColor;

    ${shaderToySource}

    void main() {
      mainImage(outColor, gl_FragCoord.xy);
    }
  `;

  function compileShader(
    gl: WebGL2RenderingContext,
    type: number,
    source: string,
  ): WebGLShader | null {
    const shader = gl.createShader(type);
    if (!shader) return null;

    gl.shaderSource(shader, source);
    gl.compileShader(shader);

    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      console.warn('Hero shader compilation failed:', gl.getShaderInfoLog(shader));
      gl.deleteShader(shader);
      return null;
    }

    return shader;
  }

  function initializeHeroShader(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext('webgl2', {
      alpha: true,
      antialias: false,
      depth: false,
      stencil: false,
      powerPreference: 'high-performance',
      preserveDrawingBuffer: false,
    });

    if (!gl) {
      canvas.hidden = true;
      return;
    }

    const vertexShader = compileShader(gl, gl.VERTEX_SHADER, vertexSource);
    const fragmentShader = compileShader(gl, gl.FRAGMENT_SHADER, fragmentSource);

    if (!vertexShader || !fragmentShader) {
      if (vertexShader) gl.deleteShader(vertexShader);
      if (fragmentShader) gl.deleteShader(fragmentShader);
      canvas.hidden = true;
      return;
    }

    const program = gl.createProgram();
    if (!program) {
      canvas.hidden = true;
      return;
    }

    gl.attachShader(program, vertexShader);
    gl.attachShader(program, fragmentShader);
    gl.linkProgram(program);
    gl.deleteShader(vertexShader);
    gl.deleteShader(fragmentShader);

    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.warn('Hero shader linking failed:', gl.getProgramInfoLog(program));
      gl.deleteProgram(program);
      canvas.hidden = true;
      return;
    }

    const vertexArray = gl.createVertexArray();
    const resolutionLocation = gl.getUniformLocation(program, 'iResolution');
    const timeLocation = gl.getUniformLocation(program, 'iTime');

    gl.useProgram(program);
    gl.bindVertexArray(vertexArray);
    canvas.dataset.shaderState = 'ready';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let isIntersecting = true;
    let frameRequest = 0;
    let lastTick = 0;
    let lastDraw = 0;
    let activeTime = 0;
    let disposed = false;

    const draw = () => {
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform3f(resolutionLocation, canvas.width, canvas.height, 1);
      gl.uniform1f(timeLocation, activeTime);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };

    const resize = () => {
      const bounds = canvas.getBoundingClientRect();
      const renderScale = window.innerWidth < 900 ? 0.6 : 0.8;
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.25);
      const width = Math.max(1, Math.round(bounds.width * pixelRatio * renderScale));
      const height = Math.max(1, Math.round(bounds.height * pixelRatio * renderScale));

      if (canvas.width !== width || canvas.height !== height) {
        canvas.width = width;
        canvas.height = height;
        draw();
      }
    };

    const canAnimate = () => (
      !disposed
      && isIntersecting
      && !document.hidden
      && !reducedMotion.matches
    );

    const stop = () => {
      if (frameRequest) cancelAnimationFrame(frameRequest);
      frameRequest = 0;
      lastTick = 0;
    };

    const loop = (timestamp: number) => {
      frameRequest = 0;
      if (!canAnimate()) return;

      if (lastTick) activeTime += Math.min(timestamp - lastTick, 80) / 1000;
      lastTick = timestamp;

      if (timestamp - lastDraw >= 1000 / 30) {
        draw();
        lastDraw = timestamp;
      }

      frameRequest = requestAnimationFrame(loop);
    };

    const updatePlayback = () => {
      if (canAnimate()) {
        if (!frameRequest) frameRequest = requestAnimationFrame(loop);
      } else {
        stop();
        if (reducedMotion.matches) {
          activeTime = 0;
          draw();
        }
      }
    };

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(canvas);

    const intersectionObserver = new IntersectionObserver(([entry]) => {
      isIntersecting = entry?.isIntersecting ?? false;
      updatePlayback();
    }, { threshold: 0.01 });
    intersectionObserver.observe(canvas);

    const handleVisibility = () => updatePlayback();
    const handleMotionPreference = () => updatePlayback();
    document.addEventListener('visibilitychange', handleVisibility);
    reducedMotion.addEventListener('change', handleMotionPreference);

    const dispose = () => {
      if (disposed) return;
      disposed = true;
      stop();
      resizeObserver.disconnect();
      intersectionObserver.disconnect();
      document.removeEventListener('visibilitychange', handleVisibility);
      reducedMotion.removeEventListener('change', handleMotionPreference);
      gl.deleteVertexArray(vertexArray);
      gl.deleteProgram(program);
    };

    canvas.addEventListener('webglcontextlost', (event) => {
      event.preventDefault();
      canvas.hidden = true;
      dispose();
    }, { once: true });
    window.addEventListener('pagehide', dispose, { once: true });

    resize();
    updatePlayback();
  }

  document.querySelectorAll<HTMLCanvasElement>('[data-hero-shader]')
    .forEach(initializeHeroShader);
</script>

<style>
  .hero-shader {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, transparent, black 7%, black 91%, transparent);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  canvas[data-shader-state='ready'] {
    opacity: 0.82;
  }

  .hero-shader__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(244, 240, 231, 0.92) 0%, rgba(244, 240, 231, 0.72) 40%, rgba(244, 240, 231, 0.18) 76%, rgba(244, 240, 231, 0.28) 100%),
      linear-gradient(to bottom, rgba(244, 240, 231, 0.2), transparent 34%, rgba(244, 240, 231, 0.24));
  }

  @media (max-width: 900px) {
    .hero-shader__veil {
      background: rgba(244, 240, 231, 0.66);
    }
  }
</style>
