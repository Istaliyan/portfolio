---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { localePath, projectsTagPath, ui, type Locale } from '../lib/site';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
  index: number;
}

const { project, locale, index } = Astro.props;
const labels = ui[locale];
const data = project.data;
const title = data.title[locale];
const summary = data.summary[locale];
const year = data.date.slice(0, 4);
---

<article class="project-card blueprint-card" data-project-card data-tags={JSON.stringify(data.tags)}>
  <div class="project-index" aria-hidden="true">P—{String(index + 1).padStart(2, '0')}</div>
  <div class="project-body">
    <div class="project-meta">
      <span>{year}</span>
      <a class="meta-tag" href={projectsTagPath(locale, data.tags[0])}>{data.tags[0]}</a>
    </div>
    <div class="project-media">
      <Image src={data.cover} alt={data.coverAlt[locale]} layout="full-width" />
    </div>
    <h3><a href={localePath(locale, `/projects/${project.id}`)}>{title}</a></h3>
    <p>{summary}</p>
    <div class="project-footer">
      <div class="tags" aria-label={locale === 'es' ? 'Etiquetas' : 'Tags'}>
        {data.tags.map((tag) => <a class="tag" href={projectsTagPath(locale, tag)}>{tag}</a>)}
      </div>
      <a class="project-link" href={localePath(locale, `/projects/${project.id}`)}>
        {labels.viewProject}<span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    min-height: 29rem;
    grid-template-columns: 3.5rem 1fr;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }
  .project-card:hover {
    border-color: color-mix(in srgb, var(--color-forest) 55%, var(--color-line));
    box-shadow: 0 1.2rem 3rem rgba(23, 35, 29, 0.06);
    transform: translateY(-4px);
  }
  .project-index {
    padding-top: 1.5rem;
    border-right: 1px solid var(--color-line);
    color: var(--color-forest-light);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    writing-mode: vertical-rl;
  }
  .project-body { display: flex; flex-direction: column; padding: clamp(1.5rem, 3vw, 2.4rem); }
  .project-meta { display: flex; justify-content: space-between; color: var(--color-muted); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .meta-tag { position: relative; z-index: 1; text-decoration: none; }
  .meta-tag:hover { color: var(--color-forest); text-decoration: underline; text-underline-offset: 0.25rem; }
  .project-media { aspect-ratio: 3 / 2; margin: 1.2rem 0 1.5rem; overflow: hidden; background: var(--color-paper-deep); }
  .project-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 300ms ease; }
  .project-card:hover .project-media :global(img) { transform: scale(1.025); }
  h3 { max-width: 15ch; margin: 0 0 0.8rem; font-family: var(--font-serif); font-size: clamp(1.75rem, 2.4vw, 2.35rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; }
  h3 a { text-decoration: none; }
  h3 a::after { position: absolute; inset: 0; content: ""; }
  p { max-width: 38rem; margin: 0; color: var(--color-muted); font-size: 0.9rem; line-height: 1.7; }
  .project-footer { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: 1.7rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tags .tag { position: relative; z-index: 1; text-decoration: none; transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease; }
  .tags .tag:hover { border-color: var(--color-forest); background: var(--color-forest); color: var(--color-paper); }
  .project-link { position: relative; z-index: 1; display: inline-flex; flex: none; gap: 0.55rem; color: var(--color-forest); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-decoration: none; text-transform: uppercase; }
  .project-link:hover { text-decoration: underline; text-underline-offset: 0.3rem; }
  @media (max-width: 560px) {
    .project-card { min-height: 27rem; grid-template-columns: 2.6rem 1fr; }
    .project-body { padding: 1.25rem; }
    .project-footer { align-items: start; flex-direction: column; }
  }
</style>
