---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, type Locale } from '../lib/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = locale === 'es' ? {
  title: 'Contacto', eyebrow: 'Canal abierto / 01', heading: 'Construyamos algo que tenga coordenadas.',
  intro: 'Estoy disponible para conversar sobre ingeniería geoespacial, ML aplicado, visualización 3D y equipos que necesiten conectar estas disciplinas.',
  preferred: 'Canal preferido', emailText: 'Escribir un email', connect: 'También puedes encontrarme aquí', note: 'Respuesta habitual: 1–2 días laborables',
} : {
  title: 'Contact', eyebrow: 'Open channel / 01', heading: 'Let’s build something with coordinates.',
  intro: 'I am open to conversations about geospatial engineering, applied ML, 3D visualization, and teams that need to connect these disciplines.',
  preferred: 'Preferred channel', emailText: 'Write an email', connect: 'You can also find me here', note: 'Typical response: 1–2 business days',
};
---

<BaseLayout locale={locale} title={copy.title} description={copy.intro}>
  <section class="page-shell contact-layout">
    <div class="contact-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 class="display-title">{copy.heading}</h1>
      <p class="lede">{copy.intro}</p>
    </div>
    <div class="contact-card blueprint-card">
      <div class="card-code"><span>COMMS / ACTIVE</span><span class="status-dot"></span></div>
      <p class="card-label">{copy.preferred}</p>
      <a class="email" href={`mailto:${site.email}`}>{site.email}<span aria-hidden="true">↗</span></a>
      <a class="button-primary" href={`mailto:${site.email}`}>{copy.emailText}</a>
      <div class="socials">
        <p>{copy.connect}</p>
        <a href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
        <a href={site.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
      <p class="response-note">{copy.note}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-layout { display: grid; min-height: calc(100vh - 5.4rem); grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: clamp(3rem, 9vw, 9rem); padding-block: clamp(5rem, 10vw, 9rem); }
  .contact-copy h1 { max-width: 11ch; margin-top: 2rem; }
  .contact-copy .lede { margin: 2rem 0 0; }
  .contact-card { padding: clamp(1.5rem, 4vw, 3.2rem); background: color-mix(in srgb, var(--color-paper-deep) 65%, transparent); }
  .card-code { display: flex; align-items: center; justify-content: space-between; color: var(--color-muted); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.09em; }
  .status-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--color-forest-light); box-shadow: 0 0 0 5px rgba(45, 92, 73, 0.1); }
  .card-label { margin: 5rem 0 0.8rem; color: var(--color-muted); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .email { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-line); color: var(--color-forest); font-family: var(--font-serif); font-size: clamp(1.25rem, 2.4vw, 2rem); text-decoration: none; }
  .email:hover { border-color: var(--color-forest); }
  .socials { display: grid; grid-template-columns: 1fr auto auto; gap: 1rem; margin-top: 4rem; padding-top: 1.2rem; border-top: 1px solid var(--color-line); }
  .socials p,
  .response-note { margin: 0; color: var(--color-muted); font-size: 0.65rem; }
  .socials a { color: var(--color-forest); font-size: 0.67rem; font-weight: 700; text-decoration: none; text-transform: uppercase; }
  .response-note { margin-top: 1.8rem; }
  @media (max-width: 760px) {
    .contact-layout { min-height: auto; grid-template-columns: 1fr; }
    .socials { grid-template-columns: 1fr 1fr; }
    .socials p { grid-column: 1 / -1; }
  }
</style>
