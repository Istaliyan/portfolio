---
import { getCollection } from 'astro:content';
import ProjectGrid from '../components/ProjectGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, site, type Locale } from '../lib/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const projects = (await getCollection('projects')).filter((project) => project.data.featured).slice(0, 3);

const copy = locale === 'es' ? {
  description: 'Portfolio de ingeniería geoespacial, machine learning, teledetección y visualización 3D.',
  status: 'Disponible para nuevos retos',
  heroA: 'Datos espaciales.',
  heroB: 'Decisiones reales.',
  intro: 'Diseño sistemas que convierten imágenes, nubes de puntos y datos territoriales en productos fiables, medibles y fáciles de usar.',
  seeProjects: 'Explorar proyectos',
  contact: 'Contactar',
  profileLabel: 'Perfil / 01',
  profileTitle: 'Ingeniería entre el territorio y el modelo.',
  profileBody: 'Trabajo en la intersección de geospatial engineering, machine learning y producto. Mi foco no es solo entrenar modelos: construyo el flujo completo, desde la calidad del dato hasta una experiencia que otras personas pueden usar y mantener.',
  values: ['Rigor espacial', 'Sistemas reproducibles', 'Entrega orientada a producto'],
  expertiseLabel: 'Especialización / 02',
  expertiseTitle: 'Del píxel a la interfaz.',
  expertiseIntro: 'Una práctica técnica transversal para resolver problemas que no caben en una sola herramienta.',
  expertise: [
    { code: 'RS', title: 'Sentinel / Remote Sensing', body: 'Series temporales, índices espectrales, STAC y automatización de pipelines raster.' },
    { code: 'PC', title: 'LiDAR / Point Clouds', body: 'Clasificación, normalización, métricas 3D y publicación eficiente de nubes masivas.' },
    { code: 'AI', title: 'GeoAI / ML', body: 'Datasets espaciales, validación geográfica, experimentación y despliegue reproducible.' },
    { code: '3D', title: 'Web GIS / Cesium', body: 'Experiencias cartográficas, 3D Tiles y visualización técnica de alto rendimiento.' },
  ],
  workLabel: 'Trabajo / 03',
  workTitle: 'Proyectos destacados',
  allProjects: 'Ver todos los proyectos',
  ctaLabel: 'Siguiente coordenada / 04',
  ctaTitle: '¿Hay un problema espacial por resolver?',
  ctaBody: 'Hablemos de datos, modelos y del producto que tiene que existir alrededor de ellos.',
  writeMe: 'Escríbeme',
} : {
  description: 'Portfolio spanning geospatial engineering, machine learning, remote sensing, and 3D visualization.',
  status: 'Open to new challenges',
  heroA: 'Spatial data.',
  heroB: 'Real decisions.',
  intro: 'I design systems that turn imagery, point clouds, and territorial data into reliable, measurable, and usable products.',
  seeProjects: 'Explore projects',
  contact: 'Get in touch',
  profileLabel: 'Profile / 01',
  profileTitle: 'Engineering between territory and model.',
  profileBody: 'I work at the intersection of geospatial engineering, machine learning, and product. My focus goes beyond training models: I build the complete flow, from data quality to an experience other people can use and maintain.',
  values: ['Spatial rigor', 'Reproducible systems', 'Product-minded delivery'],
  expertiseLabel: 'Expertise / 02',
  expertiseTitle: 'From pixel to interface.',
  expertiseIntro: 'A cross-functional technical practice for problems that do not fit into a single tool.',
  expertise: [
    { code: 'RS', title: 'Sentinel / Remote Sensing', body: 'Time series, spectral indices, STAC, and automated raster pipelines.' },
    { code: 'PC', title: 'LiDAR / Point Clouds', body: 'Classification, normalization, 3D metrics, and efficient delivery of massive clouds.' },
    { code: 'AI', title: 'GeoAI / ML', body: 'Spatial datasets, geographic validation, experimentation, and reproducible deployment.' },
    { code: '3D', title: 'Web GIS / Cesium', body: 'Cartographic experiences, 3D Tiles, and high-performance technical visualization.' },
  ],
  workLabel: 'Work / 03',
  workTitle: 'Selected projects',
  allProjects: 'View all projects',
  ctaLabel: 'Next coordinate / 04',
  ctaTitle: 'A spatial problem worth solving?',
  ctaBody: 'Let’s talk about data, models, and the product that needs to exist around them.',
  writeMe: 'Write to me',
};
---

<BaseLayout locale={locale} description={copy.description}>
  <section class="hero page-shell">
    <div class="hero-copy">
      <div class="eyebrow">{copy.status}</div>
      <h1 class="display-title">{copy.heroA}<br /><em>{copy.heroB}</em></h1>
      <p class="lede">{copy.intro}</p>
      <div class="hero-actions">
        <a class="button-primary" href={localePath(locale, '/projects')}>{copy.seeProjects}<span aria-hidden="true">↗</span></a>
        <a class="button-secondary" href={localePath(locale, '/contact')}>{copy.contact}</a>
      </div>
    </div>
    <div class="hero-instrument blueprint-card" aria-hidden="true">
      <div class="instrument-meta"><span>DATUM / ETRS89</span><span>ALT / 667M</span></div>
      <div class="orbital"><div class="orbital-point"></div></div>
      <div class="instrument-coords">40° 25′ 08″ N<br />03° 41′ 31″ W</div>
      <div class="instrument-scale"><span>0</span><span>25</span><span>50 KM</span></div>
    </div>
    <div class="hero-foot"><span>PORTFOLIO / 2026</span><span>SCROLL ↓</span></div>
  </section>

  <section class="section-pad rule">
    <div class="page-shell profile-grid">
      <div><p class="eyebrow">{copy.profileLabel}</p></div>
      <div>
        <h2 class="section-title">{copy.profileTitle}</h2>
        <p class="lede">{copy.profileBody}</p>
        <ol class="principles">
          {copy.values.map((value, index) => <li><span>0{index + 1}</span>{value}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="section-pad expertise-section">
    <div class="page-shell">
      <div class="section-head">
        <div><p class="eyebrow">{copy.expertiseLabel}</p><h2 class="section-title">{copy.expertiseTitle}</h2></div>
        <p class="lede">{copy.expertiseIntro}</p>
      </div>
      <div class="expertise-grid">
        {copy.expertise.map((item, index) => (
          <article class="expertise-card blueprint-card">
            <div class="expertise-code">{item.code}<small>0{index + 1}</small></div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad rule">
    <div class="page-shell">
      <div class="section-head projects-head">
        <div><p class="eyebrow">{copy.workLabel}</p><h2 class="section-title">{copy.workTitle}</h2></div>
        <a class="text-link" href={localePath(locale, '/projects')}>{copy.allProjects}<span aria-hidden="true">→</span></a>
      </div>
      <ProjectGrid projects={projects} locale={locale} />
    </div>
  </section>

  <section class="section-pad rule">
    <div class="page-shell contact-panel blueprint-card">
      <p class="eyebrow">{copy.ctaLabel}</p>
      <h2 class="section-title">{copy.ctaTitle}</h2>
      <p class="lede">{copy.ctaBody}</p>
      <a class="button-primary" href={`mailto:${site.email}`}>{copy.writeMe}<span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; display: grid; min-height: calc(100vh - 5.4rem); grid-template-columns: minmax(0, 1.35fr) minmax(19rem, 0.65fr); align-items: center; gap: clamp(3rem, 8vw, 8rem); padding-block: 5rem 4rem; }
  .hero-copy { position: relative; z-index: 1; }
  .hero h1 { margin-top: 1.7rem; }
  .hero h1 em { color: var(--color-forest); font-weight: 430; }
  .hero .lede { max-width: 37rem; margin: 2rem 0 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 2.2rem; }
  .hero-instrument { position: relative; aspect-ratio: 0.8; padding: 1.1rem; background: rgba(244, 240, 231, 0.34); }
  .instrument-meta { display: flex; justify-content: space-between; color: var(--color-muted); font-size: 0.55rem; font-weight: 700; letter-spacing: 0.09em; }
  .orbital { position: absolute; inset: 15%; border: 1px solid rgba(21, 61, 48, 0.25); border-radius: 50%; }
  .orbital::before,
  .orbital::after { position: absolute; border: 1px solid rgba(21, 61, 48, 0.12); border-radius: 50%; content: ""; }
  .orbital::before { inset: 15%; }
  .orbital::after { inset: 35%; }
  .orbital-point { position: absolute; top: 11%; right: 13%; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--color-signal); box-shadow: 0 0 0 7px rgba(189, 107, 67, 0.12); animation: pulse-point 2.8s ease-in-out infinite; }
  .instrument-coords { position: absolute; top: 46%; right: 0; left: 0; color: var(--color-forest); font-family: var(--font-serif); font-size: clamp(1.2rem, 2.2vw, 2rem); line-height: 1.15; text-align: center; }
  .instrument-scale { position: absolute; right: 1rem; bottom: 1rem; left: 1rem; display: flex; justify-content: space-between; padding-top: 0.5rem; border-top: 3px double var(--color-forest); color: var(--color-muted); font-size: 0.55rem; font-weight: 700; }
  .hero-foot { position: absolute; right: 0; bottom: 1rem; left: 0; display: flex; justify-content: space-between; color: var(--color-muted); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.1em; }
  .profile-grid { display: grid; grid-template-columns: minmax(12rem, 0.45fr) 1fr; gap: clamp(3rem, 8vw, 8rem); }
  .profile-grid .lede { margin: 2rem 0 0; }
  .principles { display: grid; grid-template-columns: repeat(3, 1fr); margin: 3rem 0 0; padding: 0; border-top: 1px solid var(--color-line); list-style: none; }
  .principles li { padding: 1.2rem 1rem 0 0; color: var(--color-forest); font-size: 0.78rem; font-weight: 700; }
  .principles span { display: block; margin-bottom: 0.6rem; color: var(--color-muted); font-size: 0.58rem; letter-spacing: 0.08em; }
  .expertise-section { background: color-mix(in srgb, var(--color-paper-deep) 52%, transparent); }
  .section-head { display: grid; grid-template-columns: 1fr 0.72fr; align-items: end; gap: 3rem; margin-bottom: 4rem; }
  .section-head .section-title { margin-top: 1rem; }
  .section-head .lede { margin: 0; }
  .expertise-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .expertise-card { min-height: 23rem; margin-left: -1px; padding: 1.4rem; }
  .expertise-code { display: flex; align-items: start; justify-content: space-between; color: var(--color-forest); font-family: var(--font-serif); font-size: 2rem; }
  .expertise-code small { color: var(--color-muted); font-family: var(--font-sans); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.08em; }
  .expertise-card h3 { margin: 7rem 0 1rem; font-family: var(--font-serif); font-size: 1.45rem; font-weight: 540; line-height: 1.1; }
  .expertise-card p { margin: 0; color: var(--color-muted); font-size: 0.78rem; line-height: 1.65; }
  .projects-head { grid-template-columns: 1fr auto; }
  .text-link { display: flex; align-items: center; gap: 1rem; color: var(--color-forest); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.07em; text-decoration: none; text-transform: uppercase; }
  .text-link:hover { text-decoration: underline; text-underline-offset: 0.3rem; }
  .contact-panel { padding: clamp(2rem, 6vw, 5rem); background: color-mix(in srgb, var(--color-paper-deep) 65%, transparent); }
  .contact-panel .section-title { max-width: 18ch; margin-top: 1.5rem; }
  .contact-panel .lede { margin: 1.5rem 0 2.5rem; }
  @keyframes pulse-point { 50% { transform: scale(1.2); box-shadow: 0 0 0 12px rgba(189, 107, 67, 0.06); } }
  @media (max-width: 900px) {
    .hero { min-height: auto; grid-template-columns: 1fr; }
    .hero-instrument { width: min(100%, 24rem); aspect-ratio: 1.2; }
    .expertise-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 650px) {
    .profile-grid,
    .section-head { grid-template-columns: 1fr; gap: 2rem; }
    .principles { grid-template-columns: 1fr; }
    .principles li { padding-bottom: 1rem; border-bottom: 1px solid var(--color-line); }
    .expertise-grid { grid-template-columns: 1fr; }
    .expertise-card { min-height: 18rem; }
    .expertise-card h3 { margin-top: 4rem; }
    .projects-head { grid-template-columns: 1fr; }
  }
</style>
