---
import { getCollection } from 'astro:content';
import ProjectGrid from '../components/ProjectGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../lib/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const projects = (await getCollection('projects')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const copy = locale === 'es' ? {
  title: 'Proyectos', eyebrow: 'Archivo técnico / 01', heading: 'Trabajo seleccionado',
  intro: 'Una colección abierta de sistemas geoespaciales, experimentos aplicados y productos técnicos. Usa las etiquetas para recorrer tecnologías y temas que se cruzan entre proyectos.',
} : {
  title: 'Projects', eyebrow: 'Technical archive / 01', heading: 'Selected work',
  intro: 'An open collection of geospatial systems, applied experiments, and technical products. Use tags to navigate technologies and themes that overlap across projects.',
};
---

<BaseLayout locale={locale} title={copy.title} description={copy.intro}>
  <header class="page-shell page-hero">
    <p class="eyebrow">{copy.eyebrow}</p>
    <div class="heading-grid">
      <h1 class="display-title">{copy.heading}</h1>
      <p class="lede">{copy.intro}</p>
    </div>
  </header>
  <section id="projects" class="page-shell projects-section">
    <ProjectGrid projects={projects} locale={locale} filterable />
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: clamp(4rem, 7vw, 6.5rem); }
  .heading-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; align-items: end; gap: clamp(3rem, 8vw, 8rem); margin-top: 2rem; }
  .heading-grid .lede { margin: 0; }
  .projects-section { padding-bottom: clamp(4rem, 8vw, 7rem); }
  @media (max-width: 720px) { .heading-grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>
