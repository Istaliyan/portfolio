---
import type { CollectionEntry } from 'astro:content';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, ui, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
  project: CollectionEntry<'projects'>;
}

const { locale, project } = Astro.props;
const data = project.data;
const title = data.title[locale];
const summary = data.summary[locale];
const copy = locale === 'es' ? {
  caseStudy: 'Caso de estudio', problem: 'Problema', demo: 'Vídeo / Demo', architecture: 'Arquitectura',
  architectureIntro: 'Flujo conceptual del sistema. Sustituye estos pasos por el diagrama y las decisiones reales del proyecto.',
  technologies: 'Tecnologías', results: 'Resultados', resultNote: 'Métricas provisionales para definir la futura composición.',
  projectLinks: 'Enlaces del proyecto', repository: 'Repositorio', liveDemo: 'Demo en vivo', unavailable: 'Se añadirán cuando el proyecto esté publicado.',
} : {
  caseStudy: 'Case study', problem: 'Problem', demo: 'Video / Demo', architecture: 'Architecture',
  architectureIntro: 'Conceptual system flow. Replace these steps with the real project diagram and decisions.',
  technologies: 'Technologies', results: 'Results', resultNote: 'Provisional metrics defining the future composition.',
  projectLinks: 'Project links', repository: 'Repository', liveDemo: 'Live demo', unavailable: 'These will be added when the project is published.',
};
---

<BaseLayout locale={locale} title={title} description={summary}>
  <header class="page-shell project-hero">
    <a class="back-link" href={localePath(locale, '/projects')}><span aria-hidden="true">←</span>{ui[locale].backToProjects}</a>
    <div class="project-kicker"><span>{copy.caseStudy}</span><span>{data.year}</span><span>P / {project.id.toUpperCase().slice(0, 12)}</span></div>
    <h1 class="display-title">{title}</h1>
    <div class="hero-details">
      <p class="lede">{summary}</p>
      <div class="tags">{data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
    </div>
  </header>

  <section class="section-pad rule">
    <div class="page-shell content-grid">
      <div class="section-marker"><span>01</span><p class="eyebrow">{copy.problem}</p></div>
      <div class="prose"><h2 class="section-title">{copy.problem}</h2><p>{data.problem[locale]}</p></div>
    </div>
  </section>

  <section class="section-pad demo-section">
    <div class="page-shell">
      <div class="section-marker horizontal"><span>02</span><p class="eyebrow">{copy.demo}</p></div>
      <YouTubeFacade youtubeId={data.youtubeId} title={title} locale={locale} />
    </div>
  </section>

  <section class="section-pad rule">
    <div class="page-shell content-grid">
      <div class="section-marker"><span>03</span><p class="eyebrow">{copy.architecture}</p></div>
      <div>
        <h2 class="section-title">{copy.architecture}</h2>
        <p class="architecture-intro">{copy.architectureIntro}</p>
        <ol class="architecture-flow">
          {data.architecture.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step[locale]}</strong><small>PROCESS_NODE</small></li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="section-pad technology-section">
    <div class="page-shell technology-grid">
      <div>
        <div class="section-marker horizontal"><span>04</span><p class="eyebrow">{copy.technologies}</p></div>
        <h2 class="section-title">{copy.technologies}</h2>
        <div class="technology-list">{data.technologies.map((technology, index) => <div><span>T—{String(index + 1).padStart(2, '0')}</span><strong>{technology}</strong></div>)}</div>
      </div>
      <aside class="project-links blueprint-card">
        <p class="eyebrow">{copy.projectLinks}</p>
        {data.repositoryUrl ? <a href={data.repositoryUrl}>{copy.repository}<span>↗</span></a> : <span>{copy.repository}<small>OFFLINE</small></span>}
        {data.demoUrl ? <a href={data.demoUrl}>{copy.liveDemo}<span>↗</span></a> : <span>{copy.liveDemo}<small>OFFLINE</small></span>}
        <p>{copy.unavailable}</p>
      </aside>
    </div>
  </section>

  <section class="section-pad results-section">
    <div class="page-shell">
      <div class="results-head"><div class="section-marker horizontal"><span>05</span><p class="eyebrow">{copy.results}</p></div><p>{copy.resultNote}</p></div>
      <div class="results-grid">
        {data.results.map((result) => <div><strong>{result.value}</strong><span>{result.label[locale]}</span></div>)}
      </div>
      <a class="back-link bottom" href={localePath(locale, '/projects')}><span aria-hidden="true">←</span>{ui[locale].backToProjects}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .project-hero { padding-block: 3rem clamp(5rem, 10vw, 9rem); }
  .back-link { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--color-forest); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.07em; text-decoration: none; text-transform: uppercase; }
  .back-link:hover { text-decoration: underline; text-underline-offset: 0.3rem; }
  .project-kicker { display: flex; gap: 1.4rem; margin-top: clamp(4rem, 8vw, 8rem); color: var(--color-muted); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .project-hero h1 { max-width: 14ch; margin-top: 1.5rem; }
  .hero-details { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 2rem; margin-top: 2.5rem; }
  .hero-details .lede { margin: 0; }
  .tags { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.4rem; }
  .content-grid { display: grid; grid-template-columns: minmax(10rem, 0.4fr) 1fr; gap: clamp(3rem, 9vw, 9rem); }
  .section-marker span { display: block; margin-bottom: 1rem; color: var(--color-signal); font-family: var(--font-serif); font-size: 2rem; }
  .section-marker.horizontal { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
  .section-marker.horizontal span { margin: 0; }
  .prose p,
  .architecture-intro { max-width: 48rem; margin: 2rem 0 0; color: var(--color-muted); font-size: 1rem; line-height: 1.9; }
  .demo-section { background: color-mix(in srgb, var(--color-paper-deep) 50%, transparent); }
  .architecture-flow { margin: 3rem 0 0; padding: 0; border-top: 1px solid var(--color-line); list-style: none; }
  .architecture-flow li { position: relative; display: grid; grid-template-columns: 4rem 1fr auto; align-items: center; gap: 1rem; min-height: 6rem; border-bottom: 1px solid var(--color-line); }
  .architecture-flow li::before { position: absolute; top: -1px; left: 1.85rem; width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--color-signal); content: ""; }
  .architecture-flow li > span { color: var(--color-muted); font-size: 0.62rem; font-weight: 700; }
  .architecture-flow strong { color: var(--color-forest); font-family: var(--font-serif); font-size: 1.2rem; font-weight: 520; }
  .architecture-flow small { color: var(--color-muted); font-size: 0.55rem; font-weight: 700; letter-spacing: 0.08em; }
  .technology-section { background: var(--color-forest); color: var(--color-paper); }
  .technology-grid { display: grid; grid-template-columns: 1fr minmax(18rem, 0.55fr); gap: clamp(3rem, 9vw, 9rem); }
  .technology-section .eyebrow { color: rgba(244, 240, 231, 0.7); }
  .technology-list { margin-top: 3rem; border-top: 1px solid rgba(244, 240, 231, 0.2); }
  .technology-list div { display: grid; grid-template-columns: 5rem 1fr; padding-block: 1.2rem; border-bottom: 1px solid rgba(244, 240, 231, 0.2); }
  .technology-list span { color: rgba(244, 240, 231, 0.5); font-size: 0.6rem; }
  .technology-list strong { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 500; }
  .project-links { align-self: end; padding: 2rem; border-color: rgba(244, 240, 231, 0.25); background: rgba(244, 240, 231, 0.04); }
  .project-links > a,
  .project-links > span { display: flex; justify-content: space-between; padding-block: 1rem; border-bottom: 1px solid rgba(244, 240, 231, 0.2); color: var(--color-paper); font-size: 0.72rem; font-weight: 700; text-decoration: none; text-transform: uppercase; }
  .project-links > span { color: rgba(244, 240, 231, 0.48); }
  .project-links small { font-size: 0.55rem; }
  .project-links > p:last-child { margin: 2rem 0 0; color: rgba(244, 240, 231, 0.5); font-size: 0.68rem; line-height: 1.6; }
  .results-section { background: color-mix(in srgb, var(--color-paper-deep) 55%, transparent); }
  .results-head { display: flex; align-items: start; justify-content: space-between; gap: 2rem; }
  .results-head > p { max-width: 22rem; margin: 0; color: var(--color-muted); font-size: 0.68rem; line-height: 1.6; text-align: right; }
  .results-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 2rem; border-block: 1px solid var(--color-line); }
  .results-grid div { min-height: 13rem; padding: 2rem; border-right: 1px solid var(--color-line); }
  .results-grid div:last-child { border-right: 0; }
  .results-grid strong,
  .results-grid span { display: block; }
  .results-grid strong { color: var(--color-forest); font-family: var(--font-serif); font-size: clamp(3rem, 6vw, 5.5rem); font-weight: 450; letter-spacing: -0.05em; }
  .results-grid span { margin-top: 1rem; color: var(--color-muted); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }
  .back-link.bottom { margin-top: 3rem; }
  @media (max-width: 760px) {
    .hero-details,
    .content-grid,
    .technology-grid { grid-template-columns: 1fr; }
    .tags { justify-content: flex-start; }
    .architecture-flow li { grid-template-columns: 2.5rem 1fr; padding-block: 1rem; }
    .architecture-flow small { grid-column: 2; }
    .results-grid { grid-template-columns: 1fr; }
    .results-grid div { min-height: auto; border-right: 0; border-bottom: 1px solid var(--color-line); }
    .results-grid div:last-child { border-bottom: 0; }
    .results-head { display: block; }
    .results-head > p { text-align: left; }
  }
</style>
