---
import { Image } from 'astro:assets';
import { getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, ui, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
  project: CollectionEntry<'projects'>;
}

const { locale, project } = Astro.props;
const data = project.data;
const title = data.title[locale];
const summary = data.summary[locale];
const caseStudy = await getEntry('caseStudies', `${project.id}/${locale}`);

if (!caseStudy) {
  throw new Error(`Missing ${locale} case study for project "${project.id}".`);
}

const { Content } = await render(caseStudy);
const hasProjectLinks = Boolean(data.repositoryUrl || data.demoUrl);
const copy = locale === 'es' ? {
  caseStudy: 'Caso de estudio',
  narrative: 'Memoria técnica',
  projectLinks: 'Enlaces del proyecto',
  repository: 'Repositorio',
  liveDemo: 'Demo en vivo',
} : {
  caseStudy: 'Case study',
  narrative: 'Technical narrative',
  projectLinks: 'Project links',
  repository: 'Repository',
  liveDemo: 'Live demo',
};
---

<BaseLayout locale={locale} title={title} description={summary}>
  <header class="page-shell project-hero">
    <a class="back-link" href={localePath(locale, '/projects')}><span aria-hidden="true">←</span>{ui[locale].backToProjects}</a>
    <div class="project-kicker"><span>{copy.caseStudy}</span><span>{data.year}</span><span>P / {project.id.toUpperCase().slice(0, 12)}</span></div>
    <h1 class="display-title">{title}</h1>
    <div class="hero-details">
      <p class="lede">{summary}</p>
      <div class="tags">{data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
    </div>
    <figure class="project-cover blueprint-card">
      <Image src={data.cover} alt={data.coverAlt[locale]} layout="full-width" priority />
    </figure>
  </header>

  <section class="section-pad rule">
    <div class="page-shell content-grid">
      <aside class="section-marker">
        <span>01</span>
        <p class="eyebrow">{copy.narrative}</p>
      </aside>
      <article class="case-study">
        <Content />
      </article>
    </div>
  </section>

  <footer class="project-footer-section">
    <div class="page-shell project-actions">
      {hasProjectLinks && (
        <div class="project-links" aria-label={copy.projectLinks}>
          <p class="eyebrow">{copy.projectLinks}</p>
          <div>
            {data.repositoryUrl && <a href={data.repositoryUrl}>{copy.repository}<span aria-hidden="true">↗</span></a>}
            {data.demoUrl && <a href={data.demoUrl}>{copy.liveDemo}<span aria-hidden="true">↗</span></a>}
          </div>
        </div>
      )}
      <a class="back-link bottom" href={localePath(locale, '/projects')}><span aria-hidden="true">←</span>{ui[locale].backToProjects}</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .project-hero { padding-block: 2.5rem clamp(4rem, 7vw, 6.5rem); }
  .back-link { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--color-forest); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.07em; text-decoration: none; text-transform: uppercase; }
  .back-link:hover { text-decoration: underline; text-underline-offset: 0.3rem; }
  .project-kicker { display: flex; flex-wrap: wrap; gap: 1.4rem; margin-top: clamp(3rem, 5vw, 4.5rem); color: var(--color-muted); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .project-hero h1 { max-width: 14ch; margin-top: 1.5rem; }
  .hero-details { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 2rem; margin-top: 2.5rem; }
  .hero-details .lede { margin: 0; }
  .tags { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.4rem; }
  .project-cover { aspect-ratio: 3 / 2; margin: clamp(2.5rem, 5vw, 4.5rem) 0 0; overflow: hidden; }
  .project-cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .content-grid { display: grid; grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 1fr); gap: clamp(3rem, 9vw, 9rem); }
  .section-marker span { display: block; margin-bottom: 1rem; color: var(--color-signal); font-family: var(--font-serif); font-size: 2rem; }
  .case-study { min-width: 0; max-width: 48rem; }
  .case-study :global(h2),
  .case-study :global(h3) { color: var(--color-forest); font-family: var(--font-serif); font-weight: 500; letter-spacing: -0.035em; line-height: 1.08; }
  .case-study :global(h2) { margin: 3.8rem 0 1.25rem; font-size: clamp(2rem, 3.3vw, 3.2rem); }
  .case-study :global(h2:first-child) { margin-top: 0; }
  .case-study :global(h3) { margin: 2.5rem 0 1rem; font-size: clamp(1.45rem, 2vw, 1.9rem); }
  .case-study :global(p),
  .case-study :global(li) { color: var(--color-muted); font-size: 1rem; line-height: 1.85; }
  .case-study :global(p) { margin: 0 0 1.4rem; }
  .case-study :global(ul),
  .case-study :global(ol) { margin: 0 0 1.8rem; padding-left: 1.35rem; }
  .case-study :global(li + li) { margin-top: 0.55rem; }
  .case-study :global(a) { color: var(--color-forest); text-decoration-color: var(--color-signal); text-underline-offset: 0.2em; }
  .case-study :global(blockquote) { margin: 2rem 0; padding: 0.3rem 0 0.3rem 1.3rem; border-left: 2px solid var(--color-signal); }
  .case-study :global(blockquote p) { color: var(--color-forest); font-family: var(--font-serif); font-size: 1.2rem; }
  .case-study :global(img) { display: block; width: 100%; height: auto; margin-block: 2.5rem; border: 1px solid var(--color-line); }
  .case-study :global(pre) { max-width: 100%; margin: 2rem 0; padding: 1.25rem; overflow-x: auto; border: 1px solid color-mix(in srgb, var(--color-forest-light) 60%, black); font-size: 0.86rem; line-height: 1.7; tab-size: 2; }
  .case-study :global(:not(pre) > code) { padding: 0.12em 0.38em; background: var(--color-paper-deep); color: var(--color-forest); font-size: 0.9em; }
  .case-study :global(.katex-display) { max-width: 100%; margin: 2rem 0; padding: 1rem 0; overflow-x: auto; overflow-y: hidden; }
  .case-study :global(hr) { margin: 3rem 0; border: 0; border-top: 1px solid var(--color-line); }
  .project-footer-section { padding-block: 3rem; border-top: 1px solid var(--color-line); background: color-mix(in srgb, var(--color-paper-deep) 55%, transparent); }
  .project-actions { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .project-links .eyebrow { margin: 0 0 1rem; }
  .project-links > div { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .project-links a { display: inline-flex; align-items: center; gap: 0.8rem; min-height: 2.7rem; padding: 0.7rem 0.9rem; border: 1px solid var(--color-forest); color: var(--color-forest); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.07em; text-decoration: none; text-transform: uppercase; }
  .project-links a:hover { background: var(--color-forest); color: var(--color-paper); }
  @media (max-width: 760px) {
    .hero-details,
    .content-grid { grid-template-columns: 1fr; }
    .tags { justify-content: flex-start; }
    .content-grid { gap: 2rem; }
    .project-actions { align-items: start; flex-direction: column; }
  }
</style>
