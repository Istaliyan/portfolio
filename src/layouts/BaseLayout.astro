---
import BackgroundField from '../components/BackgroundField.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import brandIconUrl from '../icons/brand-icon.png?url';
import '../styles/global.css';
import { alternateLocalePath, site, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
  title?: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role[locale]}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(alternateLocalePath(locale, Astro.url.pathname), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f0e7" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={brandIconUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === 'es' ? 'en' : 'es'} href={alternate} />
    <title>{pageTitle}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <BackgroundField />
    <SiteHeader locale={locale} pathname={Astro.url.pathname} />
    <main id="main-content"><slot /></main>
    <SiteFooter locale={locale} />
    <a
      class="back-to-top"
      href="#top"
      aria-label={locale === 'es' ? 'Volver arriba' : 'Back to top'}
      title={locale === 'es' ? 'Volver arriba' : 'Back to top'}
    ><span aria-hidden="true">↑</span></a>
  </body>
</html>

<style>
  .back-to-top {
    position: fixed;
    z-index: 20;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid var(--color-forest);
    background: color-mix(in srgb, var(--color-paper) 88%, transparent);
    box-shadow: 0 0.5rem 1.5rem rgba(23, 35, 29, 0.1);
    color: var(--color-forest);
    font-size: 1rem;
    line-height: 1;
    text-decoration: none;
    backdrop-filter: blur(6px);
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .back-to-top:hover {
    background: var(--color-forest);
    color: var(--color-paper);
    transform: translateY(-2px);
  }
</style>
